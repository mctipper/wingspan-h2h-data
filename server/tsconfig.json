// Server-side type check: inherits root options and path aliases, but with Node types
// and no DOM lib so browser globals can't creep into server code. Includes only the
// shared src modules the server imports (all DOM-free).
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": [".", "../src/types", "../src/validation"]
}
